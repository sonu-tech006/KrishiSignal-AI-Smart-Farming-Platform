# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# CLERK AUTHENTICATION (Optional production authentication)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_placeholder"
CLERK_SECRET_KEY="sk_test_placeholder"

# DATABASE PERSISTENCE
MONGODB_URI="mongodb+srv://user:pass@cluster.mongodb.net/krishisignal?retryWrites=true&w=majority"

# METEOROLOGICAL & MANDI APIS
WEATHER_API_BASE_URL="https://api.open-meteo.com/v1"
DATA_GOV_IN_API_KEY="your_data_gov_in_api_key_for_agmarknet"
IMD_API_BASE_URL="https://imd.gov.in/api"
NEXT_PUBLIC_MAP_TILE_URL="https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"
PYTHON_SERVICE_URL="http://localhost:8000"
